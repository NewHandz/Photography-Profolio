---
const { active } = Astro.props;
---

<nav>
  <div class="nav-name">
    Chenming Huang
  </div>

    <a href="/about" class:list={["nav-link", { active: active === "about" }]}>About</a>
    <a href="/contact" class:list={["nav-link", { active: active === "contact" }]}>Contact</a>
  
  <a 
  href="https://instagram.com/new_hand55"
      target="_blank"
      rel="noopener"
      class="nav-ig"
      aria-label="Instagram"
    >
  <svg width="17" height="17" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="1.5"
        stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="2" width="20" height="20" rx="5"/>
        <circle cx="12" cy="12" r="4"/>
        <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/>
      </svg>
    </a>
</nav>

<style>
  nav {
    position: relative;
    top: 0;
    left: 10px;
    display: flex;
    gap: 25px;
    padding: 10px 15px;
    z-index: 3;
  }

  .nav-name
  {
    white-space: nowrap;
    color:#c8935a;
    font-family: 'Plus Jakarta Sans', Monospace;
    font-weight: 300;
    font-size: 18px;
    letter-spacing: 0.01em;
    margin-right: auto; 
    padding-top: 2px;
  }

  .nav-ig{
    color: #c48e56;
    display: flex;
    align-items: center;
    padding-top: 2px;
    padding-right: 15px;
  }

  .nav-link {
    color: rgba(255, 255, 255, 0.55);
    text-decoration: none;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 6px 0;
    position: relative;
    transition: color 0.3s ease;
    display: flex;
    gap: 40px;
    align-items: center;
  }

  /* underline bar that slides in on hover */
  .nav-link::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0%;
    height: 1px;
    background: #c8935a;
    transition: width 0.3s ease;
  }

  .nav-link:hover {
    color: #c8935a;
  }

  .nav-link:hover::after {
    width: 100%;
  }

  /* currently active page */
  .nav-link.active {
    color: rgba(255, 255, 255, 0.9);
  }

  .nav-link.active::after {
    width: 100%;
    background: rgba(255, 255, 255, 0.4);
  }
</style>